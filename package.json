{
  "name": "ainep",
  "type": "module",
  "scripts": {
    "start": "bun src/proxy/main.ts",
    "audit": "bun src/audit/main.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "build:js": "bun build src/proxy/main.ts --target=bun --packages=external --outfile=dist/ainep.js",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "bun run build:js && bun run build:types",
    "prepack": "bun run check && bun test && bun run build"
  },
  "dependencies": {
    "desy": "0.0.29",
    "h11": "1.0.21"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "typescript": "5.9.3"
  },
  "version": "0.2.0",
  "description": "AI request gateway with provider-specific validation, running on Bun",
  "license": "MIT",
  "bin": {
    "ainep": "dist/ainep.js"
  },
  "files": [
    "dist/ainep.js"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
